# Simulation mode (default): in-process SQLite + mock Chennai dataset (no MySQL connection).
USE_MOCK_DATA=true

# Restore MySQL/Postgres by setting USE_MOCK_DATA=false and a SQLAlchemy URL:
# DATABASE_URL=mysql+pymysql://user:pass@127.0.0.1:3306/disasteriq

GEMINI_API_KEY=your_key_here
GEMINI_VISION_MODEL=gemini-2.0-flash
GEMINI_MIN_CONFIDENCE=0.55
